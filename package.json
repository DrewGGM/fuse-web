{
  "name": "fuse-web",
  "private": true,
  "version": "1.0.0",
  "description": "Fuse — a daily chain-reaction puzzle. Web build: installable, offline, no ads.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/stamp-sw.ts && vite build",
    "preview": "vite preview --port 4180",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "core:check": "tsx scripts/check-core.ts",
    "core:sync": "tsx scripts/sync-core.ts",
    "ci": "npm run lint && npm run typecheck && npm run core:check && npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0"
  }
}
