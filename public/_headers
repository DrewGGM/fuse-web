# Response headers for the static site.
#
# The CSP in index.html covers what the page may load. These are the headers a
# meta tag cannot set — frame-ancestors in particular, which is ignored in a
# <meta> and only works here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The service worker must never be cached, or a deploy cannot reach anyone:
# the browser would keep asking the old worker whether there is a new one.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Hashed filenames are immutable by construction.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The sound effects are not hashed — the service worker precaches them by name,
# so the name has to stay stable across deploys. A day is long enough that they
# cost nothing on a return visit and short enough that replacing one reaches
# players without waiting for a new service worker to install.
/sfx/*
  Cache-Control: public, max-age=86400
